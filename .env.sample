# Environmental Variables can be stored here
# Be sure to uncomment any line you populate
# Everything is optional, but some features won't work without external API access

# Kill switch for the public/hosted instance
# VITE_DISABLE_EVERYTHING='false'

# API Keys for external services (backend)
GOOGLE_CLOUD_API_KEY=''
TRANCO_USERNAME=''
TRANCO_API_KEY=''
CLOUDMERSIVE_API_KEY=''
SHODAN_API_KEY=''
GITHUB_TOKEN=''
CERTSPOTTER_TOKEN=''

# Configuration settings
# CHROME_PATH='/usr/bin/chromium' # The path the the Chromium executable
# PORT='3000'                     # Port to serve the API, when running server.js
# DISABLE_GUI='false'             # Disable the GUI, and only serve the API
# PUBLIC_API_TIMEOUT_LIMIT='25000'# Timeout for API requests, in milliseconds
# API_CORS_ORIGIN='*'             # Enable CORS, by setting your allowed hostname(s) here
# API_ENABLE_RATE_LIMIT='true'    # Enable rate limiting for the API
# API_DISABLED_CHECKS=''          # Comma-separated list of checks to disable (e.g. 'trace-route,ports')
# API_ENABLED_CHECKS=''           # If set, only these checks will run ('get-ip' stays on unless disabled)
# API_BLOCKED_HOSTS=''            # Hosts that must never be scanned (e.g. 'lan.example.com,192.168.0.0/16')
# PUBLIC_API_ENDPOINT='/api'      # The endpoint for the API (can be local or remote)
# ENABLE_ANALYTICS='false'        # Enable Plausible hit counter for the frontend
# BOSS_SERVER='false'             # Marketing homepage (only used by official instance)
# TRUST_PROXY='1'                 # Set if running behind a reverse proxy (Traefik, nginx, etc).
                                  # Use a number of hops (e.g. '1'), 'true', or a CIDR list.

# Cormorant OSINT Desk. Unset keys degrade to the public sources that do not need them.
# WEBCHECK_API_KEY=''             # When set, /api/v1 routes require this key. It maps to tenant "default"
# WEBCHECK_TENANT_KEYS=''         # Extra clients, "acme:key,other:key". Each key sees only that tenant
# WEBCHECK_DATA_DIR='.data'       # JSON store for scans, monitors, inventory, and engagement secrets
# WEBCHECK_EXPORT_DIR=''          # Mount path of a USB or external drive. Offline exports are written only here
# WEBCHECK_SCAN_CONCURRENCY='1'
# WEBCHECK_DISABLE_SCHEDULER=''   # Set true to stop the in-process monitor timer
# HIBP_API_KEY=''                 # Email breach lookup. Unset uses the public XposedOrNot index
# NVD_API_KEY=''                  # Faster NVD quota. Lookups still run without it, slowly
# CENSYS_API_TOKEN=''             # Preferred Censys read-only host lookup
# CENSYS_API_ID=''                # Legacy Censys basic auth, used only when the token is unset
# CENSYS_API_SECRET=''
# WEBCHECK_NMAP_ENABLED='false'   # Authorized Nmap stays off until this is true and nmap is installed
# WEBCHECK_NMAP_CONCURRENCY='1'
# WEBCHECK_NMAP_TIMEOUT_MS='180000'
# WEBCHECK_PENTEST_ENABLED='false'
# WEBCHECK_NUCLEI_MAX_SEVERITY='medium'
# WEBCHECK_SLACK_WEBHOOK_URL=''   # Monitor alerts for worse risk, new subdomains, certificate changes
# WEBCHECK_ALERT_EMAIL_TO=''      # Email sink. Also requires WEBCHECK_SMTP_HOST or it stays a no-op
# WEBCHECK_ALERT_EMAIL_FROM='cormorant@localhost'
# WEBCHECK_SMTP_HOST=''
# WEBCHECK_SMTP_PORT='587'        # 465 implicit TLS, 587 STARTTLS
# WEBCHECK_SMTP_USER=''
# WEBCHECK_SMTP_PASS=''
